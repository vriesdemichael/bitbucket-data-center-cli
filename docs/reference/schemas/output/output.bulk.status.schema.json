{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.bulk.status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb bulk status --json`. Data is a bulk apply-status artifact. Full artifact schema: reference/schemas/bulk-apply-status.schema.json.",
  "properties": {
    "data": {
      "additionalProperties": true,
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "const": "BulkApplyStatus"
        },
        "operationId": {
          "type": "string"
        },
        "planHash": {
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "partial_failure"
          ],
          "type": "string"
        },
        "summary": {
          "type": "object"
        },
        "targets": {
          "type": "array"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "operationId",
        "planHash",
        "status"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb bulk status output",
  "type": "object"
}
