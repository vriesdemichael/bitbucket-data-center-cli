{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.ai.skill.remove.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb ai skill remove --json`. Data names the skill, the absolute path considered, and the scope. Removing a skill that is already absent is not an error: status distinguishes the two outcomes.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "project",
            "global"
          ],
          "type": "string"
        },
        "skill": {
          "enum": [
            "bb",
            "bb-bulk"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "removed",
            "not_found"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "skill",
        "path",
        "scope"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb ai skill remove output",
  "type": "object"
}
