{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.repo.list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb repo list --json`. Data is an array of repository objects.",
  "properties": {
    "data": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "defaultBranch": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "forkable": {
            "type": "boolean"
          },
          "hierarchyId": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "statusMessage": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb repo list output",
  "type": "object"
}
