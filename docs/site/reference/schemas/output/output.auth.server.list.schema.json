{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.auth.server.list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb auth server list --json`. Data lists all stored Bitbucket server contexts.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "servers": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "Aliases": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "AuthMode": {
                "type": "string"
              },
              "Host": {
                "type": "string"
              },
              "IsDefault": {
                "type": "boolean"
              },
              "Username": {
                "type": "string"
              }
            },
            "required": [
              "Host",
              "Aliases",
              "AuthMode",
              "IsDefault"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "servers"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb auth server list output",
  "type": "object"
}
