{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.ai.skill.install.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb ai skill install --json`. Data names the skill written, the absolute path it was written to, and the scope that resolved that path.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "project",
            "global"
          ],
          "type": "string"
        },
        "skill": {
          "enum": [
            "bb",
            "bb-bulk"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "installed"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "skill",
        "path",
        "scope"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "bb.machine"
        }
      },
      "required": [
        "contract"
      ],
      "type": "object"
    },
    "version": {
      "const": "v2"
    }
  },
  "required": [
    "version",
    "data",
    "meta"
  ],
  "title": "bb ai skill install output",
  "type": "object"
}
