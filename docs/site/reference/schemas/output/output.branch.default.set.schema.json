{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.branch.default.set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb branch default set --json`. Data confirms the new default branch.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "default_branch": {
          "type": "string"
        },
        "repository": {
          "additionalProperties": true,
          "properties": {
            "ProjectKey": {
              "type": "string"
            },
            "Slug": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "repository",
        "default_branch"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb branch default set output",
  "type": "object"
}
