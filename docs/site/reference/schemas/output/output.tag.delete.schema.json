{
  "$id": "https://vriesdemichael.github.io/bitbucket-data-center-cli/latest/reference/schemas/output/output.tag.delete.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON output schema for `bb tag delete --json`. Data confirms the deleted tag name.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok"
        },
        "tag": {
          "description": "Name of the deleted tag.",
          "type": "string"
        }
      },
      "required": [
        "status",
        "tag"
      ],
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "bb_version": {
          "description": "Version of the bb binary that produced this document. Provenance for stored output, not a compatibility switch: pin the binary to pin the contract (ADR-064).",
          "minLength": 1,
          "type": "string"
        },
        "contract": {
          "const": "bb.machine"
        },
        "limit_reached": {
          "description": "Present on listing commands: true when the result set came back at --limit and there may be more behind it.",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "bb_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "data",
    "meta"
  ],
  "title": "bb tag delete output",
  "type": "object"
}
